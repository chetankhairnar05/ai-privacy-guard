{
  "manifest_version": 3,
  "name": "Local AI Privacy Guard",
  "version": "1.2",
  "description": "Intercepts prompts and gives users options to mask PII.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://copilot.com/*",
        "*://meta.ai/*",
        "*://*.meta.ai/*",
        "*://grok.com/*",
        "*://x.com/i/grok/*",
        "*://chat.deepseek.com/*",
        "*://www.perplexity.ai/*",
        "*://character.ai/*",
        "*://*.character.ai/*",
        "*://chat.qwenlm.ai/*",
        "*://tongyi.aliyun.com/*",
        "*://kimi.ai/chat/*",
        "*://kimi.moonshot.cn/*",
        "*://chat.qwen.ai/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["playground.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "privacyguard@yourdomain.com",
      "strict_min_version": "109.0"
    }
  }
}
